# Copy to .env.local for local development.
# Vercel: set VITE_CONVEX_URL as a public Config var.

VITE_CONVEX_URL=https://standing-manatee-425.convex.cloud
# VITE_CONVEX_URL=https://<prod-deployment>.convex.cloud

# Local CLI only — used by convex dev, codegen, and deploy
CONVEX_DEPLOYMENT=dev:standing-manatee-425
# CONVEX_DEPLOYMENT=prod:<prod-deployment>

# Local Vite dev server only. Requires credentials for an active local dev admin.
VITE_DEV_AUTH_BYPASS=false
ADMIN_DEV_AUTH_EMAIL=
ADMIN_DEV_AUTH_PASSWORD=
